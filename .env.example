# ============================================================================
#  Schemonlist environment
#  Copy this file to .env.local and fill in the values.
#  Full walkthrough: docs/SUPABASE_SETUP.md
# ============================================================================

# --- Supabase (required) -----------------------------------------------------
# Supabase dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co

# The *publishable / anon* key. It is safe to expose to the browser ONLY
# because every table is protected by Row Level Security. Never put the
# service_role / secret key here — it bypasses RLS entirely.
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# --- Site --------------------------------------------------------------------
# The public origin of your deployment. Used for OAuth redirects.
# Local dev: http://localhost:3000   Production: https://your-domain.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Optional ----------------------------------------------------------------
# Extra origins allowed to invoke Server Actions / load dev assets, for example
# a tunnel or a custom preview domain. Comma separated, no spaces.
# ALLOWED_ORIGINS=https://staging.example.com

# Leave unset in development to run the built-in demo mode (in-memory data,
# no Discord, no database). Demo mode is automatically disabled in production.
# SCHEMONLIST_DEMO=0

# Never used by the app itself. Only for one-off scripts you run locally.
# Keep it out of any NEXT_PUBLIC_ variable and never deploy it to a browser.
# SUPABASE_SERVICE_ROLE_KEY=
